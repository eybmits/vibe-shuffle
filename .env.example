# Public identifier from the Spotify Developer Dashboard. This is the only
# required environment variable; never put a Spotify Client Secret here.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Leave unset to use the exact browser origin and path automatically.
# If set, this value must also appear verbatim in the Spotify redirect allowlist.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
